Panels:
  - Class: rviz/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
      Splitter Ratio: 0.54
    Tree Height: 480
  - Class: rviz/Views
    Name: Views
Visualization Manager:
  Class: ""
  Enabled: true
  Global Options:
    Background Color: 255; 255; 255
    Fixed Frame: world
    Frame Rate: 20
  Displays:
    - Class: rviz/Grid
      Name: Coordinate grid
      Enabled: true
      Value: true
      Cell Size: 1
      Plane Cell Count: 40
      Normal Cell Count: 0
      Plane: XY
      Offset: {X: 0, Y: 0, Z: 0.012}
      Color: 115; 125; 132
      Alpha: 0.22
      Line Style:
        Line Width: 0.018
        Value: Lines
      Reference Frame: world
    - Class: rviz/PointCloud2
      Name: Physical LiDAR returns
      Enabled: false
      Value: false
      Topic: /vla/lidar/returns_world
      Queue Size: 2
      Style: Points
      Size (Pixels): 2
      Size (m): 0.025
      Alpha: 0.58
      Position Transformer: XYZ
      Color Transformer: FlatColor
      Color: 80; 210; 238
      Axis: Z
      Use Fixed Frame: true
      Autocompute Value Bounds: false
      Min Value: 0
      Max Value: 3.2
      Decay Time: 0
    - Class: rviz/PointCloud2
      Name: Observed occupancy voxels
      Enabled: true
      Value: true
      Topic: /vla_planner/grid_map/occupancy
      Queue Size: 1
      Style: Boxes
      Size (m): 0.15
      Alpha: 0.62
      Position Transformer: XYZ
      Color Transformer: AxisColor
      Axis: Z
      Autocompute Value Bounds: {Min Value: 0, Max Value: 3.36, Value: false}
      Use rainbow: true
      Invert Rainbow: false
      Color: 104; 160; 193
      Decay Time: 0
      Use Fixed Frame: true
    - Class: rviz/PointCloud2
      Name: Inflated safety occupancy (optional)
      Enabled: false
      Value: false
      Topic: /vla_planner/grid_map/occupancy_inflate
      Queue Size: 1
      Style: Boxes
      Size (m): 0.15
      Alpha: 0.18
      Position Transformer: XYZ
      Color Transformer: FlatColor
      Color: 244; 163; 73
      Decay Time: 0
      Use Fixed Frame: true
    - Class: rviz/MarkerArray
      Name: Drone
      Enabled: true
      Value: true
      Marker Topic: /vla/visual/drone
      Queue Size: 1
    - Class: rviz/Path
      Name: Flight trail
      Enabled: true
      Value: true
      Topic: /vla/visual/trail
      Queue Size: 1
      Line Style: Lines
      Line Width: 0.035
      Color: 0; 125; 150
      Alpha: 1
      Buffer Length: 1
    - Class: rviz/Marker
      Name: Active target
      Enabled: true
      Value: true
      Marker Topic: /vla/visual/goal
      Queue Size: 1
    - Class: rviz/MarkerArray
      Name: Landmark labels
      Enabled: false
      Value: false
      Marker Topic: /vla/visual/landmarks
      Queue Size: 1
    - Class: rviz/MarkerArray
      Name: Gallery comparison (optional)
      Enabled: false
      Value: false
      Marker Topic: /vla/visual/scene
      Queue Size: 1
    - Class: rviz/Image
      Name: Onboard RGB
      Enabled: true
      Value: true
      Image Topic: /vla/camera/image_raw
      Queue Size: 1
      Transport Hint: raw
      Unreliable: false
      Normalize Range: false
      Min Value: 0
      Max Value: 255
      Median window: 1
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
  Views:
    Current:
      Class: rviz/Orbit
      Name: Sensor map overview
      Distance: 14
      Field of View: 0.9
      Pitch: 0.82
      Yaw: 4.3
      Near Clip Distance: 0.05
      Focal Point: {X: -4.5, Y: -2.0, Z: 1.0}
      Target Frame: world
    Saved:
      - Class: rviz/Orbit
        Name: Takeoff area detail
        Distance: 10
        Field of View: 0.9
        Pitch: 0.7
        Yaw: 4.3
        Near Clip Distance: 0.05
        Focal Point: {X: -4.5, Y: -2.0, Z: 1.0}
        Target Frame: world
Window Geometry:
  Displays:
    collapsed: false
  Views:
    collapsed: true
  Onboard RGB:
    collapsed: false
  Hide Left Dock: false
  Hide Right Dock: false
  Width: 1440
  Height: 900
