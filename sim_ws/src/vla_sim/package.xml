<?xml version="1.0"?>
<package format="2"><name>vla_sim</name><version>0.1.0</version>
<description>Gazebo gallery, ray lidar and real-interface demonstration controller for Diff-VLA.</description>
<maintainer email="maintainer@example.invalid">Diff-VLA contributors</maintainer><license>GPL-3.0</license>
<buildtool_depend>catkin</buildtool_depend>
<build_depend>gazebo_dev</build_depend>
<depend>roscpp</depend><depend>rospy</depend><depend>geometry_msgs</depend><depend>nav_msgs</depend><depend>sensor_msgs</depend><depend>std_msgs</depend><depend>visualization_msgs</depend><depend>quadrotor_msgs</depend><depend>gazebo_msgs</depend><depend>tf</depend>
<depend>traj_utils</depend><depend>traj_opt</depend><depend>plan_env</depend><depend>path_searching</depend><depend>cv_bridge</depend>
<exec_depend>gazebo_ros</exec_depend><exec_depend>gazebo_plugins</exec_depend><exec_depend>rviz</exec_depend><exec_depend>diff_planner</exec_depend>
<export><gazebo_ros plugin_path="${prefix}/../../lib"/></export>
</package>
