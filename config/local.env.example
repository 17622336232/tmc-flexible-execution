# Copy to config/local.env. This shell file stays on your computer.
# Simulation default: gpt-6.1-terra / max; attack scene preparation: high.
# Authenticate your own account with:
#   bash scripts/model_login.sh
#   bash scripts/model_login.sh --list-models
# No account credentials or existing model weights are published in this repo.
# If your account has a different vision-capable model, explicitly select its
# exact catalog slug. Such experiments use a different robot configuration.
# export UAV_TASK_MODEL='your-exact-vision-model-slug'

# Start with 2 compile jobs; use 1 on a machine with limited memory.
# export VLA_BUILD_JOBS=2

# Optional rendering fallback on a computer without working hardware OpenGL.
# export LIBGL_ALWAYS_SOFTWARE=1
